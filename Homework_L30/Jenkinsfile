pipeline {
    agent any

    parameters {
        string(name: 'TAG', defaultValue: 'latest', description: 'Тег для собираемого Docker-образа')
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Запускать ли этап тестирования')
    }

    environment {
        IMAGE_NAME = 'my-web-app'
        CONTAINER_NAME = 'web-app-container'
        GIT_URL = 'https://github.com/olgagrishinaqa-netizen/Olga_Grishina_DOS35.git'
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Клонирование репозитория из ${env.GIT_URL}..."
                git branch: 'main', url: "${env.GIT_URL}"
            }
        }

        stage('Build') {
            steps {
                dir('Homework_L30') {
                    echo 'Сборка проекта...'
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            when {
                expression { params.RUN_TESTS == true }
            }
            steps {
                dir('Homework_L30') {
                    echo 'Запуск тестов...'
                    sh 'mvn test'
                }
            }
        }

        stage('Docker Build & Cleanup') {
            steps {
                dir('Homework_L30') {
                    script {
                        echo 'Очистка предыдущей версии контейнера...'
                        try {
                            sh "docker stop ${CONTAINER_NAME}"
                            sh "docker rm ${CONTAINER_NAME}"
                        } catch (Exception e) {
                            echo 'Старый контейнер не найден, продолжаем...'
                        }

                        echo 'Создание нового Docker-образа...'
                        sh "docker build -t ${IMAGE_NAME}:${params.TAG} ."
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    echo 'Запуск нового Docker-контейнера...'
                    sh "docker run -d --name ${CONTAINER_NAME} -p 8081:8080 ${IMAGE_NAME}:${params.TAG}"

                    echo 'Проверка доступности веб-приложения...'
                    sh 'sleep 3 && curl -I http://localhost:8080 || exit 1'
                }
            }
        }
    }

    post {
        success {
            echo 'Пайплайн успешно завершен!'
        }
        failure {
            echo 'Произошла ошибка во время выполнения пайплайна.'
        }
    }
}